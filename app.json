{
  "expo": {
    "name": "Ours",
    "slug": "ours",
    "version": "1.0.0",
    "scheme": "ours",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "backgroundColor": "#F4ECDD",
    "icon": "./public/icons/icon-512.png",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.guptasaransh.ours",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.guptasaransh.ours"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "name": "Ours",
      "shortName": "Ours",
      "display": "standalone",
      "startUrl": "/",
      "scope": "/",
      "orientation": "portrait",
      "backgroundColor": "#F4ECDD",
      "themeColor": "#F4ECDD"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Ours uses your photo library so you can add pictures to your shared memories."
        }
      ],
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "image": "./public/icons/icon-512.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#F4ECDD"
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Ours uses your microphone so you can send voice notes to your person."
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "7cebef1f-6b9d-4f15-b45b-8a0dfe7500f4"
      }
    }
  }
}
